	<queryString>
		<![CDATA[SELECT R.*, CONCAT(C.NOMBRE, ' ', C.AP_PATERNO, ' ', C.AP_MATERNO) AS NOMBRE, C.DIRECCION, C.PROCEDENCIA, C.TELEFONO, C.PROCEDENCIA,C.RFC FROM HOSPEDAJES R LEFT JOIN  HUESPEDES C ON R.HUESPED = C.ID
WHERE R.ID = $P{ID}]]>
	</queryString>
